<Defs>


	<ThingDef ParentName="AnimalThingBase">
		<defName>DD_Drake</defName>
		<label>drake</label>
		<description>Large, long, stocky lizards heavily reminiscent of a dragon, but without the wings. About as dangerous as a warg and as fast as a horse, these versitile reptiles are reliable battle companions.\n\nWhilst originally thought to be related to dragons, they are missing the required extra shoulderblades that would normally harbor the wings. Their similar scales and meat are now thought to be from convergent evolution.</description>
		<statBases>
			<MoveSpeed>5.6</MoveSpeed>
			<MarketValue>450</MarketValue>
			<ComfyTemperatureMin>-20</ComfyTemperatureMin>
			<FilthRate>2</FilthRate>
			<ToxicEnvironmentResistance>0.3</ToxicEnvironmentResistance>
			<Wildness>0.6</Wildness>
		</statBases>
		<comps>
			<li Class="CompProperties_EggLayer">
